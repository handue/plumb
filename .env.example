# Copy to .env and fill in. .env is gitignored; never commit real values.

# Firebase web app config (Firebase console > Project settings > Your apps).
# These identify the project and are not secrets, but keep them out of the repo anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# App Check, hosted builds: reCAPTCHA Enterprise site key (web, score-based).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# App Check, localhost only: set to "true" to have the SDK print a debug token
# in the DevTools console, register that token in the Firebase console, then
# optionally paste it here to reuse it. This IS a secret. Never commit it and
# never set it in a hosted build.
VITE_APPCHECK_DEBUG_TOKEN=

# Optional and experimental: set to "true" to show "Draft from photo", which
# asks the on-device model to draft a note from a photo. It only appears if
# Chrome reports image input as available. Leave unset to keep it off.
VITE_PHOTO_ASSIST=
